# App — use your public site URL in production (required for Google OAuth & Stripe)
AUTH_URL=http://localhost:3000
# Production example:
# AUTH_URL=https://skillstack.com.pk
# AUTH_SECRET signs and encrypts JWT session cookies.
# Generate with: openssl rand -base64 32
# REQUIRED — NextAuth will refuse to start without this in production.
AUTH_SECRET=generate-a-long-random-string

# Optional override for public business phone (default in src/lib/seo.ts)
# NEXT_PUBLIC_SITE_PHONE="+923150979359"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# One OAuth app for ALL SkillStack users. Each user connects their own Google account;
# refresh tokens are stored per user in MongoDB.
#
# Authorized redirect URIs (add every environment you use):
#   {AUTH_URL}/api/auth/callback/google
#   {AUTH_URL}/api/dashboard/gsc/callback
#
# Production (Vercel) — set AUTH_URL=https://skillstack.com.pk and add:
#   https://skillstack.com.pk/api/auth/callback/google
#   https://skillstack.com.pk/api/dashboard/gsc/callback
#
# Local dev — add:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/dashboard/gsc/callback
#
# OAuth consent screen: set User type to External and Publish the app so any Google
# user can connect (not only test users). Enable "Google Search Console API".
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# DataForSEO — powers keyword research, domain overview, backlinks, audits, AI search
# Base64 encode your login:password → echo -n "login:password" | base64
# DATAFORSEO_API_KEY=

# Firecrawl — live Google first-page search for Suri, organic competitors, keyword SERP, and brand lookup
# https://www.firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
# Optional self-hosted:
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Suri Intelligence uses DataForSEO Labs + GSC + Firecrawl only (no OpenAI/ChatGPT).
# Keep DATAFORSEO_API_KEY set for fast keyword/domain replies.

MONGODB_URI=mongodb://127.0.0.1:27017/skillstack
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/skillstack

# Nodemailer / SMTP (Gmail app password, Resend SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
# Inbox shows this name — must be "SkillStack <address>" format
EMAIL_FROM="SkillStack <hello@skillstack.com.pk>"
# IMPORTANT: If SMTP_USER is Gmail, either:
#   A) EMAIL_FROM="SkillStack <yourgmail@gmail.com>" (same account — display name only), OR
#   B) Add hello@skillstack.com.pk under Gmail → Settings → Accounts → Send mail as
# Prefer a transactional provider (Resend, Postmark, Amazon SES) with SPF+DKIM+DMARC on skillstack.com.pk.
# Optional — where contact form briefs are delivered (defaults to hello@skillstack.com.pk)
# CONTACT_TO=hello@skillstack.com.pk

# Optional — Google Search Console HTML tag content value
# GOOGLE_SITE_VERIFICATION=your-gsc-verification-token

# Stripe Payments (Credit & Debit Cards, Apple Pay, Google Pay)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# One-time Price ID from Stripe Product catalog (Dashboard → Products → Price → price_...)
STRIPE_PRICE_ID=price_...
# Stripe Webhook Secret (Dashboard → Webhooks → endpoint: {AUTH_URL}/api/webhook/stripe)
# Listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
